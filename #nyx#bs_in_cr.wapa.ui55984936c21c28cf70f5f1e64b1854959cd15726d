sap.ui.define([                                                                                                                                                                                                                                                
	"sap/m/library",                                                                                                                                                                                                                                              
	"sap/ui/core/mvc/Controller",                                                                                                                                                                                                                                 
	"sap/ui/core/Item",                                                                                                                                                                                                                                           
	"sap/m/MessageToast",                                                                                                                                                                                                                                         
	'sap/m/MessageBox'                                                                                                                                                                                                                                            
], function (MobileLibrary, Controller, Item, MessageToast, MessageBox) {                                                                                                                                                                                      
	"use strict";                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
	return Controller.extend("NYX.bsincrv01.ext.controller.UploadSet", {                                                                                                                                                                                          
		onInit: function () {                                                                                                                                                                                                                                        
			this._oUploadSet = this.byId("UploadSet");                                                                                                                                                                                                                  
			this._oUploadSet.getList().setMode(MobileLibrary.ListMode.MultiSelect);                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
			// Modify "add file" button                                                                                                                                                                                                                                 
			this._oUploadSet.getDefaultFileUploader().setButtonOnly(false);                                                                                                                                                                                             
			this._oUploadSet.getDefaultFileUploader().setIcon("sap-icon://attachment");                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
			this._oUploadSetItem = this.byId("UploadSet-UploadSetItem");                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
		},                                                                                                                                                                                                                                                           
		onAfterRendering: function(){                                                                                                                                                                                                                                
			var that = this;                                                                                                                                                                                                                                            
			var oModel = this.getView().getModel();                                                                                                                                                                                                                     
			this._oUploadSet.attachAfterItemAdded(function (oEvent) {                                                                                                                                                                                                   
				var oItem = oEvent.mParameters.item;                                                                                                                                                                                                                       
				this.addIncompleteItem(oItem);                                                                                                                                                                                                                             
			});                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
			this._oUploadSet.attachBeforeItemRemoved(function(oEvent){                                                                                                                                                                                                  
				if(oEvent.mParameters.item.sParentAggregationName === "incompleteItems"){                                                                                                                                                                                  
					this.removeIncompleteItem(oEvent.mParameters.item);                                                                                                                                                                                                       
					return;                                                                                                                                                                                                                                                   
				}                                                                                                                                                                                                                                                          
				var oMode = that.getView().getModel("mode").getData();                                                                                                                                                                                                     
				if(oMode === "edit"){                                                                                                                                                                                                                                      
					that.saveCR(that._oUploadSet);                                                                                                                                                                                                                            
				}                                                                                                                                                                                                                                                          
				var sPath = oEvent.mParameters.item.mBindingInfos.fileName.binding.oContext.sPath;                                                                                                                                                                         
				oModel.remove(sPath,{                                                                                                                                                                                                                                      
					success: function(){                                                                                                                                                                                                                                      
						MessageToast.show("Deleted the file successfully!");                                                                                                                                                                                                     
						oModel.refresh(true);                                                                                                                                                                                                                                    
					},                                                                                                                                                                                                                                                        
					error: function(error){                                                                                                                                                                                                                                   
						that.processErrorMessage(error);                                                                                                                                                                                                                         
					}	                                                                                                                                                                                                                                                        
				})                                                                                                                                                                                                                                                         
			});                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
 			this._oUploadSet.attachUploadCompleted(function (oEvent) {                                                                                                                                                                                                 
				this.addItem(oEvent.mParameters.item);                                                                                                                                                                                                                     
				oModel.refresh(true);                                                                                                                                                                                                                                      
			});&nbsp;                                                                                                                                                                                                                                                   
		},                                                                                                                                                                                                                                                           
		onUploadSelectedButton: function () {                                                                                                                                                                                                                        
			var oModel = this.getView().getModel();                                                                                                                                                                                                                     
			var crNum = this.getView().getModel("crNum").getData();                                                                                                                                                                                                     
			var oUploadSet = this._oUploadSet;                                                                                                                                                                                                                          
			                                                                                                                                                                                                                                                            
			// Save the change request if it is in the edit mode                                                                                                                                                                                                        
			var oMode = this.getView().getModel("mode").getData();                                                                                                                                                                                                      
			if(oMode === "edit"){                                                                                                                                                                                                                                       
				this.saveCR(this._oUploadSet);                                                                                                                                                                                                                             
			}                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
			this._oUploadSet.getIncompleteItems().forEach(function (oItem) {                                                                                                                                                                                            
				if (oItem.getListItem().getSelected()) {                                                                                                                                                                                                                   
					// Get the file name                                                                                                                                                                                                                                      
					var fileSize = oItem._fFileSize.toFixed(2);                                                                                                                                                                                                               
					var headerField = new Item({                                                                                                                                                                                                                              
						key: "slug",                                                                                                                                                                                                                                             
						text: oItem.getFileName() + ";" + crNum + ";" + fileSize                                                                                                                                                                                                 
					});                                                                                                                                                                                                                                                       
					oUploadSet.addHeaderField(headerField);                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
					// Get security token                                                                                                                                                                                                                                     
					headerField = new Item({                                                                                                                                                                                                                                  
						key: "x-csrf-token",                                                                                                                                                                                                                                     
						text: oModel.getSecurityToken()                                                                                                                                                                                                                          
					});                                                                                                                                                                                                                                                       
					oUploadSet.addHeaderField(headerField);                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
					// Trigger upload: Send file to backend                                                                                                                                                                                                                   
					oUploadSet.uploadItem(oItem);                                                                                                                                                                                                                             
					oUploadSet.destroyHeaderFields();                                                                                                                                                                                                                         
				}                                                                                                                                                                                                                                                          
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		onDownloadSelectedButton: function () {                                                                                                                                                                                                                      
			this._oUploadSet.getItems().forEach(function (oItem) {                                                                                                                                                                                                      
				if (oItem.getListItem().getSelected()) {                                                                                                                                                                                                                   
					oItem.download(true);                                                                                                                                                                                                                                     
				}                                                                                                                                                                                                                                                          
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		saveCR: function (oData) {                                                                                                                                                                                                                                   
			sap.ui.getCore().getEventBus().publish(                                                                                                                                                                                                                     
				"Channel",                                                                                                                                                                                                                                                 
				"Save",                                                                                                                                                                                                                                                    
				oData                                                                                                                                                                                                                                                      
			);                                                                                                                                                                                                                                                          
		},                                                                                                                                                                                                                                                           
		processErrorMessage: function (e) {                                                                                                                                                                                                                          
			//Error Messages from Backend are stored in Array now                                                                                                                                                                                                       
			var json = JSON.parse(e.responseText);                                                                                                                                                                                                                      
			var errors = json.error;                                                                                                                                                                                                                                    
			var innererror = errors.innererror                                                                                                                                                                                                                          
			var errorDetails = innererror.errordetails;                                                                                                                                                                                                                 
			var errorMessages = [];                                                                                                                                                                                                                                     
			for (let index = 0; index < errorDetails.length; index++) {                                                                                                                                                                                                 
				errorMessages.push(errorDetails[index].message)                                                                                                                                                                                                            
			}                                                                                                                                                                                                                                                           
			// print the error message                                                                                                                                                                                                                                  
			this.printErrorMessage(errorMessages);                                                                                                                                                                                                                      
		},                                                                                                                                                                                                                                                           
		printErrorMessage: function (errorMessages) {                                                                                                                                                                                                                
			//Message Box:                                                                                                                                                                                                                                              
			MessageBox.show(                                                                                                                                                                                                                                            
				errorMessages[0], {                                                                                                                                                                                                                                        
				icon: MessageBox.Icon.ERROR,                                                                                                                                                                                                                               
				title: "ERROR",                                                                                                                                                                                                                                            
				actions: [MessageBox.Action.OK],                                                                                                                                                                                                                           
				emphasizedAction: MessageBox.Action.ERROR,                                                                                                                                                                                                                 
			});                                                                                                                                                                                                                                                         
		}                                                                                                                                                                                                                                                            
	});                                                                                                                                                                                                                                                           
});                                                                                                                                                                                                                                                            
sap.ui.define([                                                                                                                                                                                                                                                
	"sap/ui/core/mvc/Controller",                                                                                                                                                                                                                                 
	"sap/ui/core/Fragment",                                                                                                                                                                                                                                       
	"sap/m/MessageToast",                                                                                                                                                                                                                                         
	"sap/m/MessageBox"                                                                                                                                                                                                                                            
], function (Controller, Fragment, MessageToast, MessageBox) {                                                                                                                                                                                                 
	"use strict";                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
	return Controller.extend("NYX.bsincrv01.ext.controller.TaskGridList", {                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
		onInit: function () {                                                                                                                                                                                                                                        
			// Initiate the Dialog                                                                                                                                                                                                                                      
			Fragment.load({                                                                                                                                                                                                                                             
				name: 'NYX.bsincrv01.ext.fragment.CreateTask_Dialog',                                                                                                                                                                                                      
				controller: this,                                                                                                                                                                                                                                          
			}).then(function (oDialog) {                                                                                                                                                                                                                                
				this._oDialogCreateTask = oDialog;                                                                                                                                                                                                                         
				this.getView().addDependent(this._oDialogCreateTask);                                                                                                                                                                                                      
			}.bind(this));                                                                                                                                                                                                                                              
		},                                                                                                                                                                                                                                                           
		onDrop1: function (oInfo) {                                                                                                                                                                                                                                  
			var oEntry = {};                                                                                                                                                                                                                                            
			oEntry.TaskStatus = "TODO";                                                                                                                                                                                                                                 
			this.updateTask(oEntry, oInfo);                                                                                                                                                                                                                             
		},                                                                                                                                                                                                                                                           
		onDrop2: function (oInfo) {                                                                                                                                                                                                                                  
			var oEntry = {};                                                                                                                                                                                                                                            
			oEntry.TaskStatus = "In Process";                                                                                                                                                                                                                           
			this.updateTask(oEntry, oInfo);                                                                                                                                                                                                                             
		},                                                                                                                                                                                                                                                           
		onDrop3: function (oInfo) {                                                                                                                                                                                                                                  
			var oEntry = {};                                                                                                                                                                                                                                            
			oEntry.TaskStatus = "Done";                                                                                                                                                                                                                                 
			this.updateTask(oEntry, oInfo);                                                                                                                                                                                                                             
		},                                                                                                                                                                                                                                                           
		onDeleteDrop: function (oInfo) {                                                                                                                                                                                                                             
			var that = this;                                                                                                                                                                                                                                            
			var oModel = this.getView().getModel();                                                                                                                                                                                                                     
			var sPath = oInfo.mParameters.dragSession.getDragControl().oBindingContexts.undefined.sPath;                                                                                                                                                                
			oModel.remove(sPath, {                                                                                                                                                                                                                                      
				success: function () {                                                                                                                                                                                                                                     
					that.updateCR(oInfo);                                                                                                                                                                                                                                     
					MessageToast.show("Deleted task successfully!");                                                                                                                                                                                                          
				},                                                                                                                                                                                                                                                         
				error: function () {                                                                                                                                                                                                                                       
					that.processErrorMessage(error)                                                                                                                                                                                                                           
				}                                                                                                                                                                                                                                                          
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		onAddTaskClick: function () {                                                                                                                                                                                                                                
			this._oDialogCreateTask.open();                                                                                                                                                                                                                             
		},                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
		onOKClick: function () {                                                                                                                                                                                                                                     
			var that = this;                                                                                                                                                                                                                                            
			var oDialog = this._oDialogCreateTask;                                                                                                                                                                                                                      
			var oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                           
			var crNum = this.getView().getModel("crNum").getData();                                                                                                                                                                                                     
			var title = this._oDialogCreateTask.getContent()[0].getContent()[1]._lastValue;                                                                                                                                                                             
			var details = this._oDialogCreateTask.getContent()[0].getContent()[3]._lastValue;                                                                                                                                                                           
                                                                                                                                                                                                                                                               
			// Check the content before sending to the backend                                                                                                                                                                                                          
			if (title === "") {                                                                                                                                                                                                                                         
				MessageToast.show("Please fill all the mandatory fields!");                                                                                                                                                                                                
				return;                                                                                                                                                                                                                                                    
			}                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
			this._oDialogCreateTask.close();                                                                                                                                                                                                                            
			var oEntry = {                                                                                                                                                                                                                                              
				CrNum: crNum,                                                                                                                                                                                                                                              
				Title: title,                                                                                                                                                                                                                                              
				Details: details                                                                                                                                                                                                                                           
			}                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
			// Create a new Task                                                                                                                                                                                                                                        
			oModel.create("/CR_HeaderSet('" + crNum + "')/CR_Task", oEntry, {                                                                                                                                                                                           
				method: "POST",                                                                                                                                                                                                                                            
				success: function (oData) {                                                                                                                                                                                                                                
					that.updateCR(oData);                                                                                                                                                                                                                                     
					MessageToast.show("Created task successfully!");                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
					// Delete content of dialog                                                                                                                                                                                                                               
					oDialog.getContent()[0].getContent()[1].setValue("");                                                                                                                                                                                                     
					oDialog.getContent()[0].getContent()[3].setValue("");                                                                                                                                                                                                     
				},                                                                                                                                                                                                                                                         
				error: function (error) {                                                                                                                                                                                                                                  
					that.processErrorMessage(error)                                                                                                                                                                                                                           
				}                                                                                                                                                                                                                                                          
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		onCancelClick: function () {                                                                                                                                                                                                                                 
			this._oDialogCreateTask.close();                                                                                                                                                                                                                            
		},                                                                                                                                                                                                                                                           
		updateTask: function (oEntry, oInfo) {                                                                                                                                                                                                                       
			var that = this;                                                                                                                                                                                                                                            
			var oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                           
			var sPath = oInfo.getParameters().draggedControl.getBindingContextPath();                                                                                                                                                                                   
			oModel.update(sPath, oEntry, {                                                                                                                                                                                                                              
				method: "PUT",                                                                                                                                                                                                                                             
				success: function (oData) {                                                                                                                                                                                                                                
					that.updateCR(oData);                                                                                                                                                                                                                                     
				},                                                                                                                                                                                                                                                         
				error: function (error) {                                                                                                                                                                                                                                  
					that.processErrorMessage(error);                                                                                                                                                                                                                          
				}                                                                                                                                                                                                                                                          
			})                                                                                                                                                                                                                                                          
		},                                                                                                                                                                                                                                                           
		updateCR: function (oData) {                                                                                                                                                                                                                                 
			sap.ui.getCore().getEventBus().publish(                                                                                                                                                                                                                     
				"Channel",                                                                                                                                                                                                                                                 
				"Update",                                                                                                                                                                                                                                                  
				oData                                                                                                                                                                                                                                                      
			);                                                                                                                                                                                                                                                          
		},                                                                                                                                                                                                                                                           
		saveCR: function (oData) {                                                                                                                                                                                                                                   
			sap.ui.getCore().getEventBus().publish(                                                                                                                                                                                                                     
				"Channel",                                                                                                                                                                                                                                                 
				"Save",                                                                                                                                                                                                                                                    
				oData                                                                                                                                                                                                                                                      
			);                                                                                                                                                                                                                                                          
		},                                                                                                                                                                                                                                                           
		itemPress: function (oEvent) {                                                                                                                                                                                                                               
			var item = oEvent.getSource();                                                                                                                                                                                                                              
			var sPath = oEvent.getSource().getBindingContext().getPath();                                                                                                                                                                                               
 			var oView = this.getView();                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
			if (!this._pPopover) {                                                                                                                                                                                                                                      
				this._pPopover = Fragment.load({                                                                                                                                                                                                                           
					id: oView.getId(),                                                                                                                                                                                                                                        
					name: "NYX.bsincrv01.ext.fragment.TaskDetails_Popover",                                                                                                                                                                                                   
					controller: this                                                                                                                                                                                                                                          
				}).then(function (oPopover) {                                                                                                                                                                                                                              
					oView.addDependent(oPopover);                                                                                                                                                                                                                             
					oPopover.bindElement(sPath);                                                                                                                                                                                                                              
					return oPopover;                                                                                                                                                                                                                                          
				});                                                                                                                                                                                                                                                        
			}else{                                                                                                                                                                                                                                                      
				this._pPopover.then(function (oPopover) {                                                                                                                                                                                                                  
					oPopover.bindElement(sPath);                                                                                                                                                                                                                              
					return oPopover;                                                                                                                                                                                                                                          
				});                                                                                                                                                                                                                                                        
			};                                                                                                                                                                                                                                                          
			this._pPopover.then(function (oPopover) {                                                                                                                                                                                                                   
				oPopover.openBy(item);                                                                                                                                                                                                                                     
			});                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
		},                                                                                                                                                                                                                                                           
		processErrorMessage: function (e) {                                                                                                                                                                                                                          
			//Error Messages from Backend are stored in Array now                                                                                                                                                                                                       
			var json = JSON.parse(e.responseText);                                                                                                                                                                                                                      
			var errors = json.error;                                                                                                                                                                                                                                    
			var innererror = errors.innererror                                                                                                                                                                                                                          
			var errorDetails = innererror.errordetails;                                                                                                                                                                                                                 
			var errorMessages = [];                                                                                                                                                                                                                                     
			for (let index = 0; index < errorDetails.length; index++) {                                                                                                                                                                                                 
				errorMessages.push(errorDetails[index].message)                                                                                                                                                                                                            
			}                                                                                                                                                                                                                                                           
			// print the error message                                                                                                                                                                                                                                  
			this.printErrorMessage(errorMessages);                                                                                                                                                                                                                      
		},                                                                                                                                                                                                                                                           
		printErrorMessage: function (errorMessages) {                                                                                                                                                                                                                
			//Message Box:                                                                                                                                                                                                                                              
			MessageBox.show(                                                                                                                                                                                                                                            
				errorMessages[0], {                                                                                                                                                                                                                                        
				icon: MessageBox.Icon.ERROR,                                                                                                                                                                                                                               
				title: "ERROR",                                                                                                                                                                                                                                            
				actions: [MessageBox.Action.OK],                                                                                                                                                                                                                           
				emphasizedAction: MessageBox.Action.ERROR,                                                                                                                                                                                                                 
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		deleteClick: function (){                                                                                                                                                                                                                                    
			MessageToast.show("Drop a task here to delete!");                                                                                                                                                                                                           
		}                                                                                                                                                                                                                                                            
	});                                                                                                                                                                                                                                                           
});                                                                                                                                                                                                                                                            
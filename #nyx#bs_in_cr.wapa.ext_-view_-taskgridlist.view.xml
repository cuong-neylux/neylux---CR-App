<mvc:View xmlns="sap.m"                                                                                                                                                                                                                                        
    xmlns:mvc="sap.ui.core.mvc"                                                                                                                                                                                                                                
    xmlns:m="sap.m"                                                                                                                                                                                                                                            
    xmlns:button="NYX.bsincrv01.control"                                                                                                                                                                                                                       
    xmlns:grid="sap.ui.layout.cssgrid"                                                                                                                                                                                                                         
    xmlns:f="sap.f"                                                                                                                                                                                                                                            
    xmlns:dnd="sap.ui.core.dnd"                                                                                                                                                                                                                                
    xmlns:l="sap.ui.layout"                                                                                                                                                                                                                                    
    xmlns:dnd-grid="sap.f.dnd" controllerName="NYX.bsincrv01.ext.controller.TaskGridList" width="100%">                                                                                                                                                        
    <Panel id="TaskView-Panel">                                                                                                                                                                                                                                
        <headerToolbar>                                                                                                                                                                                                                                        
            <Toolbar id="TaskView-Panel-Toolbar">                                                                                                                                                                                                              
                <ToolbarSpacer id="TaskView-Panel-ToolbarSpacer" />                                                                                                                                                                                            
                <Button id="addTaskButton" press="onAddTaskClick" text="{@i18n>op_addTask}" type="Ghost" />                                                                                                                                                    
            </Toolbar>                                                                                                                                                                                                                                         
        </headerToolbar>                                                                                                                                                                                                                                       
        <m:HBox id="TaskView-Hbox">                                                                                                                                                                                                                            
            <m:HBox id="TaskView-Hbox1" width="33%" renderType="Bare">                                                                                                                                                                                         
                <f:GridList id="gridList1" headerText="TODO" items="{                                                                                                                                                                                          
						path: 'CR_Task',                                                                                                                                                                                                                                         
						filters: {path: 'TaskStatus', operator: 'EQ', value1: 'TODO'}                                                                                                                                                                                            
					}" showSeparators="Inner" mode="None" width="95%">                                                                                                                                                                                                        
                    <f:dragDropConfig>                                                                                                                                                                                                                         
                        <dnd:DragInfo id="gridList1-DragInfo1" sourceAggregation="items" />                                                                                                                                                                    
                        <dnd-grid:GridDropInfo id="gridList1-GridDropInfo1" dropPosition="OnOrBetween" dropLayout="Default" dropEffect="Link" drop="onDrop1" />                                                                                                
                    </f:dragDropConfig>                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    <f:customLayout>                                                                                                                                                                                                                           
                        <grid:GridBoxLayout id="gridList1-GridBoxLayout1" boxMinWidth="17rem" boxWidth="100%" />                                                                                                                                               
                    </f:customLayout>                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    <f:GridListItem id="gridList1-GridListItem11" highlight="Information" class="gridListItem1" type="Active" press="itemPress">                                                                                                               
                        <VBox id="gridList1-GridListItem1-VBox12" class="sapUiTinyMarginTopBottom sapUiMediumMarginBeginEnd">                                                                                                                                  
                            <Title id="gridList1-GridListItem1-Title1" text="{Title}" wrapping="true" />                                                                                                                                                       
                            <Label id="gridList1-GridListItem1-Label1" text="{ path: 'CreateTimestamp',                                                                                                                                                        
				                        type: 'sap.ui.model.type.DateTime',                                                                                                                                                                                                
				                        formatOptions: {                                                                                                                                                                                                                   
					                    style: 'short'}}" wrapping="true" />                                                                                                                                                                                                  
                        </VBox>                                                                                                                                                                                                                                
                    </f:GridListItem>                                                                                                                                                                                                                          
                </f:GridList>                                                                                                                                                                                                                                  
            </m:HBox>                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            <m:HBox id="TaskView-Hbox2" width="33%" renderType="Bare">                                                                                                                                                                                         
                <f:GridList id="gridList2" headerText="In Process" items="{                                                                                                                                                                                    
						path: 'CR_Task',                                                                                                                                                                                                                                         
						filters: {path: 'TaskStatus', operator: 'EQ', value1: 'In Process'}                                                                                                                                                                                      
					}" mode="None" width="95%">                                                                                                                                                                                                                               
                    <f:dragDropConfig>                                                                                                                                                                                                                         
                        <dnd:DragInfo id="gridList1-DragInfo2" sourceAggregation="items" />                                                                                                                                                                    
                        <dnd-grid:GridDropInfo id="gridList1-GridDropInfo2" dropPosition="OnOrBetween" dropLayout="Horizontal" drop="onDrop2" />                                                                                                               
                    </f:dragDropConfig>                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    <f:customLayout>                                                                                                                                                                                                                           
                        <grid:GridBoxLayout id="gridList1-GridBoxLayout2" boxMinWidth="17rem" boxWidth="100%" />                                                                                                                                               
                    </f:customLayout>                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    <f:GridListItem id="gridList1-GridListItem21" highlight="Warning" class="gridListItem2" type="Active" press="itemPress">                                                                                                                   
                        <VBox id="gridList1-GridListItem1-VBox22" class="sapUiTinyMarginTopBottom sapUiMediumMarginBeginEnd">                                                                                                                                  
                            <Title id="gridList1-GridListItem1-Title2" text="{Title}" wrapping="false" />                                                                                                                                                      
                            <Label id="gridList1-GridListItem1-Label2" text="{ path: 'CreateTimestamp',                                                                                                                                                        
				                        type: 'sap.ui.model.type.DateTime',                                                                                                                                                                                                
				                        formatOptions: {                                                                                                                                                                                                                   
					                    style: 'short'}}" wrapping="true" />                                                                                                                                                                                                  
                        </VBox>                                                                                                                                                                                                                                
                    </f:GridListItem>                                                                                                                                                                                                                          
                </f:GridList>                                                                                                                                                                                                                                  
            </m:HBox>                                                                                                                                                                                                                                          
            <m:HBox id="TaskView-Hbox3" width="33%" renderType="Bare">                                                                                                                                                                                         
                <f:GridList id="gridList3" headerText="Done" items="{                                                                                                                                                                                          
						path: 'CR_Task',                                                                                                                                                                                                                                         
						filters: {path: 'TaskStatus', operator: 'EQ', value1: 'Done'}                                                                                                                                                                                            
					}" mode="None" width="95%">                                                                                                                                                                                                                               
                    <f:dragDropConfig>                                                                                                                                                                                                                         
                        <dnd:DragInfo id="gridList1-DragInfo3" sourceAggregation="items" />                                                                                                                                                                    
                        <dnd-grid:GridDropInfo id="gridList1-GridDropInfo3" dropPosition="OnOrBetween" dropLayout="Horizontal" drop="onDrop3" />                                                                                                               
                    </f:dragDropConfig>                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    <f:customLayout>                                                                                                                                                                                                                           
                        <grid:GridBoxLayout id="gridList1-GridBoxLayout3" boxMinWidth="17rem" boxWidth="100%" />                                                                                                                                               
                    </f:customLayout>                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    <f:GridListItem id="gridList1-GridListItem31" highlight="Success" class="gridListItem3" type="Active" press="itemPress">                                                                                                                   
                        <VBox id="gridList1-GridListItem1-VBox32" class="sapUiTinyMarginTopBottom sapUiMediumMarginBeginEnd">                                                                                                                                  
                            <Title id="gridList1-GridListItem1-Title3" text="{Title}" wrapping="true" />                                                                                                                                                       
                            <Label id="gridList1-GridListItem1-Label3" text="{ path: 'CreateTimestamp',                                                                                                                                                        
				                        type: 'sap.ui.model.type.DateTime',                                                                                                                                                                                                
				                        formatOptions: {                                                                                                                                                                                                                   
					                    style: 'short'}}" wrapping="true" />                                                                                                                                                                                                  
                        </VBox>                                                                                                                                                                                                                                
                    </f:GridListItem>                                                                                                                                                                                                                          
                </f:GridList>                                                                                                                                                                                                                                  
            </m:HBox>                                                                                                                                                                                                                                          
        </m:HBox>                                                                                                                                                                                                                                              
        <Toolbar id="TaskView-Panel-Toolbar2" height="10vh" class="TaskView-class">                                                                                                                                                                            
            <ToolbarSpacer id="TaskView-Panel-ToolbarSpacer3" width="46%" />                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            <button:DeleteTaskButton text="{@i18n>op_deleteButton}" press="deleteClick" id="deleteTaskButton" class="myDeleteTaskButton" type="Reject" width="8%" icon="sap-icon://delete">                                                                    
                <button:dragDropConfig>                                                                                                                                                                                                                        
                    <dnd:DropInfo id="deleteTask-DropInfo" drop="onDeleteDrop"/>                                                                                                                                                                               
                </button:dragDropConfig>                                                                                                                                                                                                                       
            </button:DeleteTaskButton>                                                                                                                                                                                                                         
        </Toolbar>                                                                                                                                                                                                                                             
    </Panel>                                                                                                                                                                                                                                                   
</mvc:View>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
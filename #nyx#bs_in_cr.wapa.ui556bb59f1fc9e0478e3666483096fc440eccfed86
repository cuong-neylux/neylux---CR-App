            onAfterRendering: function () {                                                                                                                                                                                                                    
                var that = this;                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                // Attach a handler to the PageDataLoaded event. This event is fired each time the object page is navigated to or the object to be displayed is changed Note.                                                                                  
                this.extensionAPI.attachPageDataLoaded(function (oEvent) {                                                                                                                                                                                     
                    var oMode = this.getView().getModel("mode").getData();                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                    // Set invisibilty of unnecessary buttons                                                                                                                                                                                                  
                    if (this._oShareButton !== undefined) {                                                                                                                                                                                                    
                        this._oShareButton.setVisible(false);                                                                                                                                                                                                  
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // Set invisiblity of elements base on mode                                                                                                                                                                                                
                    switch (oMode) {                                                                                                                                                                                                                           
                        case "edit":                                                                                                                                                                                                                           
                            this._oToolbar.setVisible(true);                                                                                                                                                                                                   
                            this._oCloseButton.setVisible(true);                                                                                                                                                                                               
                            this._oFooterSubmit.setVisible(true);                                                                                                                                                                                              
                            this._oInformInCC.setVisible(true);                                                                                                                                                                                                
                            break;                                                                                                                                                                                                                             
                        case "create":                                                                                                                                                                                                                         
                            this._oToolbar.setVisible(true);                                                                                                                                                                                                   
                            this._oCloseButton.setVisible(false);                                                                                                                                                                                              
                            this._oFooterSubmit.setVisible(true);                                                                                                                                                                                              
                            this._oInformInCC.setVisible(true);                                                                                                                                                                                                
                            break;                                                                                                                                                                                                                             
                        default:                                                                                                                                                                                                                               
                            this._oToolbar.setVisible(false);                                                                                                                                                                                                  
                            this._oCloseButton.setVisible(true);                                                                                                                                                                                               
                            this._oFooterSubmit.setVisible(true);                                                                                                                                                                                              
                            this._oInformInCC.setVisible(true);                                                                                                                                                                                                
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    var crObject = oEvent.context.sPath;                                                                                                                                                                                                       
                    //Store current CrNum in model                                                                                                                                                                                                             
                    var crNum = this.getOwnerComponent().getModel().getProperty(crObject).CrNum;                                                                                                                                                               
                    this._sPath = crObject;                                                                                                                                                                                                                    
                    this.getView().getModel("crNum").setData(crNum);                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
                    // Show close button for requester                                                                                                                                                                                                         
                    var close_visible = this.getOwnerComponent().getModel().getProperty(crObject).Closable;                                                                                                                                                    
                    var developer_check = this.getOwnerComponent().getModel().getProperty(crObject).Developer;                                                                                                                                                 
                    debugger;                                                                                                                                                                                                                                  
                    if (close_visible == false) {                                                                                                                                                                                                              
                        this._oCloseButton.setVisible(false);                                                                                                                                                                                                  
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // disable next processor select if the step is Send To Requester                                                                                                                                                                          
                    var stepId = this.getOwnerComponent().getModel().getProperty(crObject).StepId;                                                                                                                                                             
                    if (stepId === "04" || stepId === "09") {                                                                                                                                                                                                  
                        that._oNextProcessor.setVisible(false);                                                                                                                                                                                                
                    } else {                                                                                                                                                                                                                                   
                        that._oNextProcessor.setVisible(true);                                                                                                                                                                                                 
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    if (stepId === "09") {                                                                                                                                                                                                                     
                        that._oFooterSubmit.setVisible(false);                                                                                                                                                                                                 
                        that._oInformInCC.setVisible(false);                                                                                                                                                                                                   
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // Show TODO list to developers only                                                                                                                                                                                                       
                    if (developer_check === true) {                                                                                                                                                                                                            
                        this._todoList.setVisible(true);                                                                                                                                                                                                       
                    } else {                                                                                                                                                                                                                                   
                        this._todoList.setVisible(false);                                                                                                                                                                                                      
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    var classification = this.getOwnerComponent().getModel().getProperty(crObject).CrClassificationId;                                                                                                                                         
                    that.classificationChangeVisibility(classification);                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                }.bind(this));                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                this.extensionAPI.getTransactionController().attachAfterSave(function (oEvent) {                                                                                                                                                               
                    var oPromise = oEvent.saveEntityPromise;                                                                                                                                                                                                   
                    oPromise.then(function (oData) {                                                                                                                                                                                                           
                        // do something if needed after save is triggered;                                                                                                                                                                                     
                        that._oToolbar.setVisible(false);                                                                                                                                                                                                      
                        that.getView().getModel("mode").setData("display");                                                                                                                                                                                    
                        that.getView().getModel().refresh(true);                                                                                                                                                                                               
                    });                                                                                                                                                                                                                                        
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                this.extensionAPI.getTransactionController().attachAfterDelete(function (oEvent) {                                                                                                                                                             
                    var oPromise = oEvent.deleteEntityPromise;                                                                                                                                                                                                 
                    oPromise.then(function () {                                                                                                                                                                                                                
                    }).catch(error => {                                                                                                                                                                                                                        
                        that.processErrorMessage(error.response);                                                                                                                                                                                              
                    });                                                                                                                                                                                                                                        
                })                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                if (this._oNextStep !== undefined) {                                                                                                                                                                                                           
                    this._oNextStep.attachChange(function (oData) {                                                                                                                                                                                            
                        var value = oData.getParameters().value;                                                                                                                                                                                               
                        if (value === "Send To Requester" || value === "Set Status to On Hold") {                                                                                                                                                              
                            that._oNextProcessor.setVisible(false);                                                                                                                                                                                            
                        } else {                                                                                                                                                                                                                               
                            that._oNextProcessor.setVisible(true);                                                                                                                                                                                             
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        that._oFooterSubmit.setVisible(true);                                                                                                                                                                                                  
                        that._oInformInCC.setVisible(true);                                                                                                                                                                                                    
                        if (value === "Set Status to On Hold") {                                                                                                                                                                                               
                            that._oFooterSubmit.setVisible(false);                                                                                                                                                                                             
                            that._oInformInCC.setVisible(false);                                                                                                                                                                                               
                        }                                                                                                                                                                                                                                      
                    });                                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            },                                                                                                                                                                                                                                                 
            beforeDeleteExtension: function () {                                                                                                                                                                                                               
                var crNum = this.getView().getModel("crNum").getData();                                                                                                                                                                                        
                var oMessageText = {                                                                                                                                                                                                                           

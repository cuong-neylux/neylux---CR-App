sap.ui.define([                                                                                                                                                                                                                                                
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/m/MessageBox"],                                                                                                                                                                                                                                       
    function (MessageToast, MessageBox) {                                                                                                                                                                                                                      
        "use strict";                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        return {                                                                                                                                                                                                                                               
            onInit: function () {                                                                                                                                                                                                                              
                sap.ui.getCore().getEventBus().subscribe(                                                                                                                                                                                                      
                    "Channel",                                                                                                                                                                                                                                 
                    "Update",                                                                                                                                                                                                                                  
                    this.UpdateCR,                                                                                                                                                                                                                             
                    this                                                                                                                                                                                                                                       
                );                                                                                                                                                                                                                                             
                sap.ui.getCore().getEventBus().subscribe(                                                                                                                                                                                                      
                    "Channel",                                                                                                                                                                                                                                 
                    "Save",                                                                                                                                                                                                                                    
                    this.SaveCR,                                                                                                                                                                                                                               
                    this                                                                                                                                                                                                                                       
                );                                                                                                                                                                                                                                             
                this._oFooterSubmit = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--submitButton");                                                                                                 
                this._oFooterSubmit.setType("Emphasized");                                                                                                                                                                                                     
                this._oCloseButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--closeButton");                                                                                                   
                this._oCloseButton.setType("Emphasized");                                                                                                                                                                                                      
                this._oToolbar = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--template::ObjectPage::FooterToolbar");                                                                               
                this._oEditButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--edit");                                                                                                           
                this._oCancelButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--cancel");                                                                                                       
                this._oSaveButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--save");                                                                                                           
                this._oNextStep = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--op_section_nextProcesssor::StepText::Field");                                                                       
                this._oNextProcessor = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--op_section_nextProcesssor::NextProcessorFullname::Field");                                                     
                this._oInformInCC = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--op_section_nextProcesssor::InformCcFullname::Field");                                                             
                this._hiddenInfo = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--op_section1_column4::FormGroup");                                                                                  
                this._oShareButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--template::Share");                                                                                               

                if (action !== undefined) {                                                                                                                                                                                                                    
                    debugger;                                                                                                                                                                                                                                  
                    action.setValue("SAVE");                                                                                                                                                                                                                   
                }                                                                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
            onSubmitClick: function () {                                                                                                                                                                                                                       
                // Check mandatory fields for submit                                                                                                                                                                                                           
                var cr_nextprocessor = "";                                                                                                                                                                                                                     
                var cr_nextstep = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--op_section_nextProcesssor::StepText::Field-input").getValue();                                                      
                if (cr_nextstep !== "Send To Requester") {                                                                                                                                                                                                     
                    cr_nextprocessor = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--op_section_nextProcesssor::NextProcessorFullname::Field-input").getValue();                                    
                }                                                                                                                                                                                                                                              
                var cr_note = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--op_section_nextProcesssor::CurrentNote::Field-textArea").getValue();                                                    
                if (cr_nextstep === "" || (cr_nextstep !== "Send To Requester" && cr_nextprocessor === "") || cr_note === "") {                                                                                                                                
                    var warning_message = this.getView().getModel("i18n").getResourceBundle().getText("submit_warning_message");                                                                                                                               
                    MessageBox.show(warning_message);                                                                                                                                                                                                          
                    return;                                                                                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // Change User Action to SUBMIT                                                                                                                                                                                                                
                var action = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--op_section1_column4::UserAction::Field");                                                                                
                if (action !== undefined) {                                                                                                                                                                                                                    
                    debugger;                                                                                                                                                                                                                                  
                    action.setValue("SUBMIT");                                                                                                                                                                                                                 
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                //Save the change request first                                                                                                                                                                                                                
                this._oSaveButton.firePress();                                                                                                                                                                                                                 
            },                                                                                                                                                                                                                                                 
            onCloseClick: function () {                                                                                                                                                                                                                        
                var that = this;                                                                                                                                                                                                                               
                var action = that.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ObjectPage.view.Details::CR_HeaderSet--op_section1_column4::UserAction::Field");                                                                                
                if (action) {                                                                                                                                                                                                                                  
                    action.setValue("CLOSE");                                                                                                                                                                                                                  

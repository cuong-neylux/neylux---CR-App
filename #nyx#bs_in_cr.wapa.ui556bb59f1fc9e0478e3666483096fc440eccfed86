            },                                                                                                                                                                                                                                                 
            UpdateCR: function (sChannelId, sEventId, sData) {                                                                                                                                                                                                 
                // For updating the CR after changing the task                                                                                                                                                                                                 
                var that = this;                                                                                                                                                                                                                               
                var sPath = this._sPath;                                                                                                                                                                                                                       
                var oModel = this.getView().getModel();                                                                                                                                                                                                        
                oModel.read(sPath, {                                                                                                                                                                                                                           
                    success: function (oData) {                                                                                                                                                                                                                
                        oModel.update(sPath, oData, {                                                                                                                                                                                                          
                            success: function () {                                                                                                                                                                                                             
                                oModel.refresh(true);                                                                                                                                                                                                          
                            },                                                                                                                                                                                                                                 
                            error: function (error) {                                                                                                                                                                                                          
                                that.processErrorMessage(error);                                                                                                                                                                                               
                            }                                                                                                                                                                                                                                  
                        })                                                                                                                                                                                                                                     
                    },                                                                                                                                                                                                                                         
                    error: function (error) {                                                                                                                                                                                                                  
                        that.processErrorMessage(error);                                                                                                                                                                                                       
                    }                                                                                                                                                                                                                                          
                })                                                                                                                                                                                                                                             
            },                                                                                                                                                                                                                                                 
            SaveCR: function (sChannelId, sEventId, sData) {                                                                                                                                                                                                   
                this._oSaveButton.firePress();                                                                                                                                                                                                                 
            },                                                                                                                                                                                                                                                 
            classificationChangeVisibility: function(classification){                                                                                                                                                                                          
                   switch (classification) {                                                                                                                                                                                                                   
                        case "0001":                                                                                                                                                                                                                           
                            this._transportRequestSection.setVisible(false);                                                                                                                                                                                   
                            this._neyluxProduct.setVisible(false);                                                                                                                                                                                             
                            this._freshdeskTicketNumber.setVisible(true);                                                                                                                                                                                      
                            break;                                                                                                                                                                                                                             
                        case "0003":                                                                                                                                                                                                                           
                            this._transportRequestSection.setVisible(true);                                                                                                                                                                                    
                            this._neyluxProduct.setVisible(true);                                                                                                                                                                                              
                            this._freshdeskTicketNumber.setVisible(true);                                                                                                                                                                                      
                            break;                                                                                                                                                                                                                             
                        default:                                                                                                                                                                                                                               
                            this._transportRequestSection.setVisible(false);                                                                                                                                                                                   
                            this._neyluxProduct.setVisible(false);                                                                                                                                                                                             
                            this._freshdeskTicketNumber.setVisible(false);                                                                                                                                                                                     
                    }                                                                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
            ,                                                                                                                                                                                                                                                  
            processErrorMessage: function (e) {                                                                                                                                                                                                                
                //Error Messages from Backend are stored in Array now                                                                                                                                                                                          
                var json = JSON.parse(e.responseText);                                                                                                                                                                                                         
                var errors = json.error;                                                                                                                                                                                                                       
                var innererror = errors.innererror                                                                                                                                                                                                             
                var errorDetails = innererror.errordetails;                                                                                                                                                                                                    
                var errorMessages = [];                                                                                                                                                                                                                        
                for (let index = 0; index < errorDetails.length; index++) {                                                                                                                                                                                    
                    errorMessages.push(errorDetails[index].message)                                                                                                                                                                                            
                }                                                                                                                                                                                                                                              
                // print the error message                                                                                                                                                                                                                     
                this.printErrorMessage(errorMessages);                                                                                                                                                                                                         
            },                                                                                                                                                                                                                                                 
            printErrorMessage: function (errorMessages) {                                                                                                                                                                                                      
                //Message Box:                                                                                                                                                                                                                                 
                MessageBox.show(                                                                                                                                                                                                                               
                    errorMessages[0], {                                                                                                                                                                                                                        
                    icon: MessageBox.Icon.ERROR,                                                                                                                                                                                                               
                    title: "ERROR",                                                                                                                                                                                                                            
                    actions: [MessageBox.Action.OK],                                                                                                                                                                                                           
                    emphasizedAction: MessageBox.Action.ERROR,                                                                                                                                                                                                 
                });                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
        };                                                                                                                                                                                                                                                     

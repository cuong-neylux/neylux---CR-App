<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout">                                                                                                                                                                       
    <Dialog title="{@i18n>create_task_dialog}" id="createTaskDialog">                                                                                                                                                                                          
        <l:VerticalLayout id="createTaskDialog-VerticalLayout" class="sapUiSmallMarginBeginEnd" width="550px">                                                                                                                                                 
            <l:content>                                                                                                                                                                                                                                        
                <Label id="createTaskDialog-Title" design="Bold" required="true" text="{@i18n>op_task_title}" labelFor="taskTextInput" />                                                                                                                      
                <TextArea id="taskTitleInput" placeholder="{@i18n>op_task_title_holder}" width="100%" required="true" maxLength="64"/>                                                                                                                         
                                                                                                                                                                                                                                                               
                 <Label id="createTaskDialog-details" design="Bold" text="{@i18n>op_task_details}" labelFor="taskTextInput" />                                                                                                                                 
                <TextArea id="taskDetailsInput" placeholder="{@i18n>op_task_text_holder}" width="100%" maxLength="255" required="true"/>                                                                                                                       
            </l:content>                                                                                                                                                                                                                                       
        </l:VerticalLayout>                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        <beginButton>                                                                                                                                                                                                                                          
            <Button text="{@i18n>OKButton}" press="onOKClick" id="Task-Dialog-OKButton" />                                                                                                                                                                     
        </beginButton>                                                                                                                                                                                                                                         
        <endButton>                                                                                                                                                                                                                                            
            <Button text="{@i18n>CancelButton}" press="onCancelClick" id="Task-Dialog-CancelButton" />                                                                                                                                                         
        </endButton>                                                                                                                                                                                                                                           
    </Dialog>                                                                                                                                                                                                                                                  
</core:FragmentDefinition>                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
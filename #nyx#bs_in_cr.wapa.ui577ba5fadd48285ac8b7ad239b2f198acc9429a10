sap.ui.define([                                                                                                                                                                                                                                                
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/m/MessageBox"],                                                                                                                                                                                                                                       
    function (MessageToast, MessageBox) {                                                                                                                                                                                                                      
        "use strict";                                                                                                                                                                                                                                          
        return {                                                                                                                                                                                                                                               
            onInit: function () {                                                                                                                                                                                                                              
                this._oCreateButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ListReport.view.ListReport::CR_HeaderSet--addEntry");                                                                                                  
                this._oTable = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ListReport.view.ListReport::CR_HeaderSet--responsiveTable");                                                                                                  
                                                                                                                                                                                                                                                               
            },                                                                                                                                                                                                                                                 
            /*                                                                                                                                                                                                                                                 
            * onAfterRendering: Enhance the List Report page with some logic after rendering the page                                                                                                                                                          
            *&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                        
            */                                                                                                                                                                                                                                                 
            onAfterRendering: function () {                                                                                                                                                                                                                    
                this._oShowDetailsButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ListReport.view.ListReport::CR_HeaderSet--listReport-btnShowHideDetails");                                                                        
                this._oSettingButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ListReport.view.ListReport::CR_HeaderSet--listReport-btnPersonalisation");                                                                            
                this._oDivExcelExport = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ListReport.view.ListReport::CR_HeaderSet--listReport-btnExcelExport");                                                                               
                this._oAdaptFilterButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ListReport.view.ListReport::CR_HeaderSet--listReportFilter-btnFilters");                                                                          
                this._oShareButton = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ListReport.view.ListReport::CR_HeaderSet--template::Share");                                                                                            
                                                                                                                                                                                                                                                               
                //Hide settings button                                                                                                                                                                                                                         
                this._oTableColumn = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ListReport.view.ListReport::CR_HeaderSet--template:::ListReportTable:::ColumnListItem");                                                                
                this._oTableColumn.attachPress(this.onItemClick, this);                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                //Table Buttons                                                                                                                                                                                                                                
                this._oCreateButton.setType("Emphasized");                                                                                                                                                                                                     
                this._oCreateButton.attachPress(this.onCreateClick, this);                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                // Set the invisibility of unnecessary buttons                                                                                                                                                                                                 
                if (this._oShowDetailsButton !== undefined) {                                                                                                                                                                                                  
                    this._oShowDetailsButton.setVisible(false);                                                                                                                                                                                                
                }                                                                                                                                                                                                                                              
                if (this._oSettingButton !== undefined) {                                                                                                                                                                                                      
                    this._oSettingButton.setVisible(false);                                                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
                if (this._oDivExcelExport !== undefined) {                                                                                                                                                                                                     
                    this._oDivExcelExport.setVisible(false);                                                                                                                                                                                                   
                }                                                                                                                                                                                                                                              
                if (this._oAdaptFilterButton !== undefined) {                                                                                                                                                                                                  
                    //this._oAdaptFilterButton.setVisible(false);                                                                                                                                                                                              
                    this._oAdaptFilterButton.setEnabled(false);                                                                                                                                                                                                
                }                                                                                                                                                                                                                                              
                if (this._oShareButton !== undefined) {                                                                                                                                                                                                        
                    this._oShareButton.setVisible(false);                                                                                                                                                                                                      
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                debugger;                                                                                                                                                                                                                                      
                var customerCombobox = this.getView().byId("NYX.bsincrv01::sap.suite.ui.generic.template.ListReport.view.ListReport::CR_HeaderSet--listReportFilter-filterItemControl_BASIC-CustomerId");                                                      
                if(customerCombobox !== undefined){                                                                                                                                                                                                            
                    var customerModel = customerCombobox.getModel();                                                                                                                                                                                           
                    if(customerModel !== undefined){                                                                                                                                                                                                           
                        customerModel.setSizeLimit(500);                                                                                                                                                                                                       
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
            ,                                                                                                                                                                                                                                                  
            onCopyClick: function () {                                                                                                                                                                                                                         
                var oModel = this.getView().getModel();                                                                                                                                                                                                        
                var sPath = this._oTable.getSelectedContextPaths()[0];                                                                                                                                                                                         
                var text = this.getView().getModel("i18n").getResourceBundle().getText("copyCR");                                                                                                                                                              
                var that = this;                                                                                                                                                                                                                               
                oModel.read(sPath, {                                                                                                                                                                                                                           
                    success: function (oData) {                                                                                                                                                                                                                
                        var oEntry = {                                                                                                                                                                                                                         
                            CustomerId: oData.CustomerId,                                                                                                                                                                                                      
                            CustomerName: oData.CustomerName,                                                                                                                                                                                                  
                            ProjectId: oData.ProjectId,                                                                                                                                                                                                        
                            ProjectName: oData.ProjectName,                                                                                                                                                                                                    
                            CrHeading: oData.CrHeading,                                                                                                                                                                                                        
                            CrClassification: oData.CrClassification,                                                                                                                                                                                          
                            CrDetails: oData.CrDetails,                                                                                                                                                                                                        
                            EffortEstimate: oData.EffortEstimate,                                                                                                                                                                                              
                            UserAction: "COPY"                                                                                                                                                                                                                 
                        };                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                        oModel.create("/CR_HeaderSet", oEntry, {                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                            success: function () {                                                                                                                                                                                                             
                                MessageToast.show(text)                                                                                                                                                                                                        
                                oModel.refresh(true);                                                                                                                                                                                                          
                            },                                                                                                                                                                                                                                 
                            error: function (error) {                                                                                                                                                                                                          
                                that.processErrorMessage(error);                                                                                                                                                                                               
                            }                                                                                                                                                                                                                                  
                        });                                                                                                                                                                                                                                    
                    },                                                                                                                                                                                                                                         
                    error: function (error) {                                                                                                                                                                                                                  
                        that.processErrorMessage(error);                                                                                                                                                                                                       
                    }                                                                                                                                                                                                                                          
                })                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            },                                                                                                                                                                                                                                                 
            onUserGuideClick: function(){&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                            
                sap.m.URLHelper.redirect("https://neylux.sharepoint.com/:w:/g/Intern/Projekte/EWIwsLgPRYpNuYq0Wm2MqwQBiEiyd_oe-WBbfKR4b3jlDQ?e=1ums47", true);&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                   
            },                                                                                                                                                                                                                                                 
            onReqSpecDocumentClick: function(){&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                      
                sap.m.URLHelper.redirect("https://neylux.sharepoint.com/:f:/g/Intern/Projekte/EqHJVJCVZnBAj5UJL1GhPr0BbTTscwLpQYXTs2yvuXJWIQ?e=hWEQC8", true);&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                   
            },                                                                                                                                                                                                                                                 
            beforeDeleteExtension: function (oBeforeDeleteProperties) {                                                                                                                                                                                        
                var words = oBeforeDeleteProperties.aContexts[0].sPath.split("'");                                                                                                                                                                             
                var oMessageText = {                                                                                                                                                                                                                           
                    title: this.getView().getModel("i18n").getResourceBundle().getText("deleteCRTitle") + " " + words[1],                                                                                                                                      
                    text: this.getView().getModel("i18n").getResourceBundle().getText("deleteCRText"),                                                                                                                                                         
                };                                                                                                                                                                                                                                             
                return Promise.resolve(oMessageText);                                                                                                                                                                                                          
            },                                                                                                                                                                                                                                                 
            onCreateClick: function () {                                                                                                                                                                                                                       
                this.getView().getModel("mode").setData("create");                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                // empty links list                                                                                                                                                                                                                            
                sap.ui.getCore().getEventBus().publish(                                                                                                                                                                                                        
                    "Channel",                                                                                                                                                                                                                                 
                    "EmptyLinkList",                                                                                                                                                                                                                           
                    this)                                                                                                                                                                                                                                      
            },                                                                                                                                                                                                                                                 
            onItemClick: function () {                                                                                                                                                                                                                         
                this.getView().getModel("mode").setData("display");                                                                                                                                                                                            
            },                                                                                                                                                                                                                                                 
            processErrorMessage: function (e) {                                                                                                                                                                                                                
                //Error Messages from Backend are stored in Array now                                                                                                                                                                                          
                var json = JSON.parse(e.responseText);                                                                                                                                                                                                         
                var errors = json.error;                                                                                                                                                                                                                       
                var innererror = errors.innererror                                                                                                                                                                                                             
                var errorDetails = innererror.errordetails;                                                                                                                                                                                                    
                var errorMessages = [];                                                                                                                                                                                                                        
                for (let index = 0; index < errorDetails.length; index++) {                                                                                                                                                                                    
                    errorMessages.push(errorDetails[index].message)                                                                                                                                                                                            
                }                                                                                                                                                                                                                                              
                // print the error message                                                                                                                                                                                                                     
                this.printErrorMessage(errorMessages);                                                                                                                                                                                                         
            },                                                                                                                                                                                                                                                 
            printErrorMessage: function (errorMessages) {                                                                                                                                                                                                      
                //Message Box:                                                                                                                                                                                                                                 
                MessageBox.show(                                                                                                                                                                                                                               
                    errorMessages[0], {                                                                                                                                                                                                                        
                    icon: MessageBox.Icon.ERROR,                                                                                                                                                                                                               
                    title: "ERROR",                                                                                                                                                                                                                            
                    actions: [MessageBox.Action.OK],                                                                                                                                                                                                           
                    emphasizedAction: MessageBox.Action.ERROR,                                                                                                                                                                                                 
                });                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
        };                                                                                                                                                                                                                                                     
    });                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
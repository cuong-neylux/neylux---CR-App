<core:View id="timelineView" controllerName="NYX.bsincrv01.ext.controller.Timeline"                                                                                                                                                                            
	xmlns="sap.suite.ui.commons"                                                                                                                                                                                                                                  
	xmlns:core="sap.ui.core.mvc"                                                                                                                                                                                                                                  
	xmlns:m="sap.m" width="100%" height="100%">                                                                                                                                                                                                                   
	<Timeline id="idTimeline" axisOrientation="Horizontal" sortOldestFirst="true" dateTimePath="{CommentTimestamp}" sort="true" enableDoubleSided="false" lazyLoading="true" textHeight="automatic" content="{CR_Comment}" enableScroll="true" growingThreshold="+
10000" showHeaderBar="false" showIcons="true">                                                                                                                                                                                                                 
		<content>                                                                                                                                                                                                                                                    
			<TimelineItem id="idTemplateItem" maxCharacters="50000" dateTime="{CommentTimestamp}" title="{Title}" text="{Note}" userName="{CommentUserFullname}" userPicture="{ImageUrl}">                                                                              
			</TimelineItem>                                                                                                                                                                                                                                             
		</content>                                                                                                                                                                                                                                                   
	</Timeline>                                                                                                                                                                                                                                                   
</core:View>                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
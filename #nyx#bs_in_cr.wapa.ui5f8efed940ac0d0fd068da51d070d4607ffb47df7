sap.ui.define([                                                                                                                                                                                                                                                
    'sap/m/MessageBox',                                                                                                                                                                                                                                        
    'sap/ui/core/mvc/Controller',                                                                                                                                                                                                                              
    "sap/ui/core/Fragment",                                                                                                                                                                                                                                    
    "sap/m/MessageToast"                                                                                                                                                                                                                                       
], function (MessageBox, Controller, Fragment, MessageToast) {                                                                                                                                                                                                 
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var LinkGroupController = Controller.extend("NYX.bsincrv01.ext.controller.Link", {                                                                                                                                                                         
                                                                                                                                                                                                                                                               
        onInit: function () {                                                                                                                                                                                                                                  
            Fragment.load({                                                                                                                                                                                                                                    
                name: 'NYX.bsincrv01.ext.fragment.CreateLink_Dialog',                                                                                                                                                                                          
                controller: this,                                                                                                                                                                                                                              
            }).then(function (oDialog) {                                                                                                                                                                                                                       
                this._oDialogCreateLink = oDialog;                                                                                                                                                                                                             
                this.getView().addDependent(this._oDialogCreateLink);                                                                                                                                                                                          
            }.bind(this));                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            this._oTable = this.byId("linkTable");                                                                                                                                                                                                             
            this._oColumn = this.byId("LinkTable-ColumnsListItem");                                                                                                                                                                                            
            this.addList = [];                                                                                                                                                                                                                                 
            this.deleteList = [];                                                                                                                                                                                                                              
            this._counter = 0;                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            this._oTable.removeAllItems();                                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
        onAddLinkClick: function () {                                                                                                                                                                                                                          
            this._oDialogCreateLink.open();                                                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
        onOKClick: function () {                                                                                                                                                                                                                               
            var that = this;                                                                                                                                                                                                                                   
            var oModel = this.getView().getModel();                                                                                                                                                                                                            
            var linkText = this._oDialogCreateLink.getContent()[0].getContent()[1]._lastValue;                                                                                                                                                                 
            var url = this._oDialogCreateLink.getContent()[0].getContent()[3]._lastValue;                                                                                                                                                                      
            var CrNum = this.getView().getModel("crNum").getData();                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            // Check the content before sending to the backend                                                                                                                                                                                                 
            if (linkText === "" || url === "") {                                                                                                                                                                                                               
                MessageToast.show("Please fill all the mandatory fields!");                                                                                                                                                                                    
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
            this._oDialogCreateLink.close();                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            var oEntry = {                                                                                                                                                                                                                                     
                CrNum: CrNum,                                                                                                                                                                                                                                  
                Text: linkText,                                                                                                                                                                                                                                
                Url: url                                                                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
            oModel.create("/CR_HeaderSet('" + CrNum + "')/CR_Links", oEntry, {                                                                                                                                                                                 
                method: "POST",                                                                                                                                                                                                                                
                success: async function () {                                                                                                                                                                                                                   
                    that.byId("linkTable").getBinding("items").refresh();                                                                                                                                                                                      
                },                                                                                                                                                                                                                                             
                error: function (error) {                                                                                                                                                                                                                      
                    that.processErrorMessage(error);                                                                                                                                                                                                           
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // Delete content after getting the data, so that next time the dialog is opened, the field are reset                                                                                                                                              
            this._oDialogCreateLink.getContent()[0].getContent()[1].setValue("");                                                                                                                                                                              
            this._oDialogCreateLink.getContent()[0].getContent()[3].setValue("");                                                                                                                                                                              
        },                                                                                                                                                                                                                                                     
        onDeleteLinkClick: function () {                                                                                                                                                                                                                       
            var that = this;                                                                                                                                                                                                                                   
            var oModel = this.getView().getModel();                                                                                                                                                                                                            
            var selectedItem = this._oTable.getSelectedItem();                                                                                                                                                                                                 
            if (selectedItem) {                                                                                                                                                                                                                                
                var sPath = selectedItem.getBindingContextPath();                                                                                                                                                                                              
                oModel.remove(sPath, {                                                                                                                                                                                                                         
                    success: function () {                                                                                                                                                                                                                     
                        that.byId("linkTable").getBinding("items").refresh();                                                                                                                                                                                  
                    },                                                                                                                                                                                                                                         
                    error: function (error) {                                                                                                                                                                                                                  
                        that.processErrorMessage(error);                                                                                                                                                                                                       
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
        onCancelClick: function () {                                                                                                                                                                                                                           
            this._oDialogCreateLink.close();                                                                                                                                                                                                                   
        },                                                                                                                                                                                                                                                     
        processErrorMessage: function (e) {                                                                                                                                                                                                                    
            //Error Messages from Backend are stored in Array now                                                                                                                                                                                              
            var json = JSON.parse(e.responseText);                                                                                                                                                                                                             
            var errors = json.error;                                                                                                                                                                                                                           
            var innererror = errors.innererror                                                                                                                                                                                                                 
            var errorDetails = innererror.errordetails;                                                                                                                                                                                                        
            var errorMessages = [];                                                                                                                                                                                                                            
            for (let index = 0; index < errorDetails.length; index++) {                                                                                                                                                                                        
                errorMessages.push(errorDetails[index].message)                                                                                                                                                                                                
            }                                                                                                                                                                                                                                                  
            // print the error message                                                                                                                                                                                                                         
            this.printErrorMessage(errorMessages);                                                                                                                                                                                                             
        },                                                                                                                                                                                                                                                     
        printErrorMessage: function (errorMessages) {                                                                                                                                                                                                          
            //Message Box:                                                                                                                                                                                                                                     
            MessageBox.show(                                                                                                                                                                                                                                   
                errorMessages[0], {                                                                                                                                                                                                                            
                icon: MessageBox.Icon.ERROR,                                                                                                                                                                                                                   
                title: "ERROR",                                                                                                                                                                                                                                
                actions: [MessageBox.Action.OK],                                                                                                                                                                                                               
                emphasizedAction: MessageBox.Action.ERROR,                                                                                                                                                                                                     
            });                                                                                                                                                                                                                                                
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
    return LinkGroupController;                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
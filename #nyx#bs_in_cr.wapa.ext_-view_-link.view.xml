<mvc:View controllerName="NYX.bsincrv01.ext.controller.Link" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:smartField="sap.ui.comp.smartfield">                                                                                                              
&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                                                       
    <Table id="linkTable" mode="SingleSelectLeft" showNoData="true" inset="false" autoPopinMode="true" backgroundDesign="Translucent" items="{path: 'CR_Links'}">                                                                                              
        <headerToolbar>                                                                                                                                                                                                                                        
            <OverflowToolbar id="linkTable-OverflowToolbar" style="Standard" height="30px">                                                                                                                                                                    
                <ToolbarSpacer id="linkTable-Toolbarspacer" />                                                                                                                                                                                                 
                <Button id="addTask" text="{@i18n>op_addButton}" type="Ghost" press="onAddLinkClick" />                                                                                                                                                        
                <Button id="deleteTask" text="{@i18n>op_deleteButton}" type="Ghost" press="onDeleteLinkClick" />                                                                                                                                               
            </OverflowToolbar>                                                                                                                                                                                                                                 
        </headerToolbar>                                                                                                                                                                                                                                       
        <columns>                                                                                                                                                                                                                                              
            <Column id="linkTable-Column1" demandPopin="true" width="20%">                                                                                                                                                                                     
                <Text id="linkTable-Text1" text="{@i18n>op_link_creator}" />                                                                                                                                                                                   
            </Column>                                                                                                                                                                                                                                          
            <Column id="linkTable-Column2" demandPopin="true" width="80%">                                                                                                                                                                                     
                <Text id="linkTable-Text2" text="{@i18n>op_link_text}" />                                                                                                                                                                                      
            </Column>                                                                                                                                                                                                                                          
        </columns>                                                                                                                                                                                                                                             
        <ColumnListItem id="linkTable-ColumnsListItem" class="LinkView-ColumnListItem">                                                                                                                                                                        
            <Text id="linkTable-creator" text="{CreatorFullname}" />                                                                                                                                                                                           
            <Link id="linkTable-Link" target="_blank" text="{Text}" subtle="true" href="{Url}" />                                                                                                                                                              
        </ColumnListItem>                                                                                                                                                                                                                                      
    </Table>                                                                                                                                                                                                                                                   
</mvc:View>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               